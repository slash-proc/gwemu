# Keep the docker build context lean -- without this, COPY . . drags the
# 8GB sdcard image, firmware backups, reference PDFs/SDK and both build
# trees into every layer (real incident: 100GB of build cache, host disk
# at 97%).

# Build trees (all variants)
backup/
build*/
bf-*/
sdk/
retro-go-temp/

# Large binary blobs and media
*.bin
*.img
*.qcow2
*.7z
*.mp3
*.pdf
*.svd
perf.data
mac_report.log

# Git metadata
.git/

